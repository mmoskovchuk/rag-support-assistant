# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Generate random secrets with:  openssl rand -hex 32

# --- Secrets (required) ---
API_KEY=change-me
OPENAI_API_KEY=sk-...
N8N_ENCRYPTION_KEY=change-me

# --- Host ports (change if they clash with other projects) ---
API_HOST_PORT=8100
CHROMA_HOST_PORT=8101
N8N_HOST_PORT=5690

# --- General ---
TZ=Europe/Kyiv
LOG_LEVEL=INFO

# --- Optional overrides (defaults live in app/support_rag/config.py) ---
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_INPUT_PRICE_PER_1M=0.40    # update together with OPENAI_MODEL; used for cost logging
# OPENAI_OUTPUT_PRICE_PER_1M=1.60
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_QUERY_PREFIX=       # e5 models need "query: "
# EMBEDDING_DOCUMENT_PREFIX=    # e5 models need "passage: "
# RELEVANCE_THRESHOLD=0.45
# TOP_K=4
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# OCR_LANGUAGES=ukr+eng
# PDF_MIN_TEXT_CHARS=30
# SUGGESTION_POOL_K=20
# MAX_SUGGESTED_TOPICS=5
